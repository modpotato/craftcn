package {{ package }};

import net.kyori.adventure.text.Component;
import net.kyori.adventure.text.format.NamedTextColor;
import net.kyori.adventure.text.format.TextColor;
import net.kyori.adventure.text.format.TextDecoration;
import org.bukkit.Material;
import org.bukkit.Sound;

/**
 * Generated by CraftCN - Theme: {{ theme.name }}
 * Description: {{ theme.description }}
 * 
 * This file serves as the global design system for your UI components.
 * All generated components reference these constants for consistent styling.
 */
public class UITheme {
    
    // ========================================
    // COLOR PALETTE
    // ========================================
    
    public static final TextColor PRIMARY = parseColor("{{ theme.palette.primary }}");
    public static final TextColor SECONDARY = parseColor("{{ theme.palette.secondary }}");
    public static final TextColor ACCENT = parseColor("{{ theme.palette.accent }}");
    public static final TextColor DESTRUCTIVE = parseColor("{{ theme.palette.destructive }}");
    public static final TextColor MUTED = parseColor("{{ theme.palette.muted }}");
    public static final TextColor BACKGROUND = parseColor("{{ theme.palette.background }}");
    public static final TextColor FOREGROUND = parseColor("{{ theme.palette.foreground }}");
    
    // ========================================
    // TEXT STYLES
    // ========================================
    
    public static final Style TITLE_STYLE = new Style(PRIMARY, TextDecoration.BOLD);
    public static final Style SUBTITLE_STYLE = new Style(SECONDARY);
    public static final Style ACCENT_STYLE = new Style(ACCENT, TextDecoration.ITALIC);
    public static final Style ERROR_STYLE = new Style(DESTRUCTIVE, TextDecoration.BOLD);
    public static final Style SUCCESS_STYLE = new Style(ACCENT, TextDecoration.BOLD);
    public static final Style MUTED_STYLE = new Style(MUTED);
    
    // ========================================
    // MATERIAL ASSETS
    // ========================================
    
    public static final Material FILLER_GLASS = Material.valueOf("{{ theme.assets.filler_glass }}");
    public static final Material BACK_BUTTON = Material.valueOf("{{ theme.assets.back_button }}");
    public static final Material NEXT_BUTTON = Material.valueOf("{{ theme.assets.next_button }}");
    public static final Material ERROR_ICON = Material.valueOf("{{ theme.assets.error_icon }}");
    public static final Material SUCCESS_ICON = Material.valueOf("{{ theme.assets.success_icon }}");
    
    // ========================================
    // SOUNDS
    // ========================================
    
    {% for sound_name, sound_value in theme.sounds.items() %}
    public static final Sound {{ sound_name|to_uppercase }} = Sound.valueOf("{{ sound_value }}");
    {% endfor %}
    
    // ========================================
    // UTILITY METHODS
    // ========================================
    
    private static TextColor parseColor(String colorString) {
        try {
            return NamedTextColor.NAMES.valueOrThrow(colorString.toLowerCase());
        } catch (IllegalArgumentException e) {
            try {
                return TextColor.fromHexString(colorString);
            } catch (Exception ex) {
                return NamedTextColor.WHITE;
            }
        }
    }
    
    /**
     * Helper class for combining text colors and decorations
     */
    public static class Style {
        private final TextColor color;
        private final TextDecoration decoration;
        
        public Style(TextColor color) {
            this(color, null);
        }
        
        public Style(TextColor color, TextDecoration decoration) {
            this.color = color;
            this.decoration = decoration;
        }
        
        public TextColor getColor() {
            return color;
        }
        
        public TextDecoration getDecoration() {
            return decoration;
        }
        
        public net.kyori.adventure.text.format.Style toStyle() {
            net.kyori.adventure.text.format.Style.Builder builder = 
                net.kyori.adventure.text.format.Style.style().color(color);
            if (decoration != null) {
                builder.decorate(decoration);
            }
            return builder.build();
        }
        
        public Component apply(String text) {
            return Component.text(text, toStyle());
        }
    }
}
